# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Virtual environments ---
.venv/
venv/
env/

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini

# --- Office lock files ---
~$*

# --- Runtime artefacts (generated during play, never source) ---
ui_images/
saves/
logs/
world_journal.txt
image_events.jsonl
turn_*.jpg
turn_*.png

# --- Scratch ---
tmp_*
*.tmp
*.bak
*.orig

# --- Recorded LLM fixtures are committed on purpose; caches are not ---
tests/fixtures/**/*.live.json

# --- Node, only used to build the stylesheet ---
node_modules/

# --- Runtime state, not source ---
# The character registry moved to the user data directory beside the saves
# (Core/Paths.py: CHARACTERS_DIR). The copy left here is the seed the game
# carries across once, on first run after the move, and is safe to delete
# afterwards. It is not tracked because the game writes to it every turn:
# six turns of play produced twenty-four modified or new files.
Characters/
art/style_review/
